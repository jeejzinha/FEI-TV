/* ------------------------------------------
   UTILITÁRIOS
   ------------------------------------------ */
void invalida() {
    printf("Opcao invalida, tente novamente.\n");
}

void to_lower(char *str, char *dest) {
    int i;
    for (i = 0; str[i]; i++)
        dest[i] = tolower((unsigned char)str[i]);
    dest[strlen(str)] = '\0';
}

/* ------------------------------------------
   STRUCT DE VIDEO
   ------------------------------------------ */
typedef struct {
    char titulo[100];
    char duracao[10];
    char descricao[200];
    char canal[100];
} Video;

/* ------------------------------------------
   CURTIDAS
   ------------------------------------------
   Arquivo curtidos.txt: uma linha por curtida
   Formato: username;titulo_do_video
   ------------------------------------------ */

/* Retorna 1 se o usuário já curtiu o vídeo, 0 caso contrário */
int ja_curtiu(const char *titulo) {
    FILE *f = fopen("curtidos.txt", "r");
    if (!f) return 0;

    char u[100], t[100];
    while (fscanf(f, " %99[^;];%99[^\n]", u, t) == 2) {
        if (strcmp(u, usuario_logado) == 0 && strcmp(t, titulo) == 0) {
            fclose(f);
            return 1;
        }
    }
    fclose(f);
    return 0;
}

/* Adiciona curtida ao arquivo */
void curtir(const char *titulo) {
    FILE *f = fopen("curtidos.txt", "a");
    if (!f) { printf("Erro ao salvar curtida.\n"); return; }
    fprintf(f, "%s;%s\n", usuario_logado, titulo);
    fclose(f);
    printf("<3 Video curtido!\n");
}

/* Remove curtida do arquivo (reescreve sem a linha) */
void descurtir(const char *titulo) {
    FILE *f = fopen("curtidos.txt", "r");
    if (!f) return;

    /* lê todas as linhas */
    char linhas[500][210];
    int total = 0;
    char u[100], t[100];
    while (fscanf(f, " %99[^;];%99[^\n]", u, t) == 2) {
        /* mantém todas EXCETO a do usuário+título atual */
        if (!(strcmp(u, usuario_logado) == 0 && strcmp(t, titulo) == 0)) {
            snprintf(linhas[total], sizeof(linhas[total]), "%s;%s", u, t);
            total++;
        }
    }
    fclose(f);

    /* reescreve o arquivo */
    f = fopen("curtidos.txt", "w");
    if (!f) { printf("Erro ao atualizar curtidas.\n"); return; }
    {
        int i;
        for (i = 0; i < total; i++)
            fprintf(f, "%s\n", linhas[i]);
    }
    fclose(f);

    printf("Video removido dos curtidos.\n");
}

/* ------------------------------------------
   CONTA / LOGIN
   ------------------------------------------ */
int username_valido(char *username) {
    FILE *f = fopen("usuarios.txt", "r");
    if (!f) return 1; /* arquivo não existe ainda ? username livre */

    char u[100], s[100];
    while (fscanf(f, " %99[^;];%99[^\n]", u, s) == 2) {
        if (strcmp(u, username) == 0) {
            fclose(f);
            return 0; /* já existe */
        }
    }
    fclose(f);
    return 1; /* disponível */
}

void criar_conta() {
    char username[100], senha[100];
    printf("=== Criar Conta ===\n");

    printf("Crie seu username *Be creative ;) : ");
    scanf(" %99[^\n]", username);

    while (!username_valido(username)) {
        printf("Este username ja existe, tente outro.\n");
        printf("Crie seu username *Be creative ;) : ");
        scanf(" %99[^\n]", username);
    }

    printf("Crie sua senha: ");
    scanf(" %99[^\n]", senha);

    FILE *f = fopen("usuarios.txt", "a");
    fprintf(f, "%s;%s\n", username, senha);
    fclose(f);

    printf("Conta criada com sucesso!\n");
    menu_inicial();
}

void fazer_login() {
    char username[100], senha[100];
    printf("=== Area de Login ===\n");
    printf("Digite seu username: ");
    scanf(" %99[^\n]", username);
    printf("Insira sua senha: ");
    scanf(" %99[^\n]", senha);

    FILE *f = fopen("usuarios.txt", "r");
    if (!f) { printf("Erro: arquivo de usuarios nao encontrado.\n"); return; }

    char u[100], s[100];
    int encontrado = 0;
    while (fscanf(f, " %99[^;];%99[^\n]", u, s) == 2) {
        if (strcmp(u, username) == 0 && strcmp(s, senha) == 0) {
            encontrado = 1;
            break;
        }
    }
    fclose(f);

    if (encontrado) {
        /* ? salva o usuário na sessão global */
        strncpy(usuario_logado, username, sizeof(usuario_logado) - 1);
        printf("Ola, %s, nice to see u here :)\n", usuario_logado);
        menu_principal();
    } else {
        printf("Username ou senha incorretos.\n");
        fazer_login();
    }
}

