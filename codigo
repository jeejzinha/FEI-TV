/* ------------------------------------------
   BUSCAR
   ------------------------------------------ */
void buscar() {
    FILE *arq = fopen("videos.txt", "r");
    if (!arq) { printf("Erro ao abrir o arquivo de videos.\n"); return; }

    /* pula o cabeçalho */
    char linha[512];
    fgets(linha, sizeof(linha), arq);

    Video videos[100];
    int total = 0;
    while (fgets(linha, sizeof(linha), arq)) {
        linha[strcspn(linha, "\n")] = '\0';
        Video v;
        int lido = sscanf(linha, "%99[^;];%9[^;];%199[^;];%99[^\n]",
                          v.titulo, v.duracao, v.descricao, v.canal);
        if (lido >= 4)
            videos[total++] = v;
    }
    fclose(arq);

    char busca[100];
    printf("Digite o titulo do video: ");
    scanf(" %99[^\n]", busca);

    char busca_low[100], titulo_low[100];
    to_lower(busca, busca_low);

    Video resultados[100];
    int n_res = 0;
    {
        int i;
        for (i = 0; i < total; i++) {
            to_lower(videos[i].titulo, titulo_low);
            if (strstr(titulo_low, busca_low))
                resultados[n_res++] = videos[i];
        }
    }

    if (n_res == 0) {printf("Nenhum video encontrado.\n");
        menu_principal();
        return;}
        

    printf("\n");
    {int i;
        for (i = 0; i < n_res; i++)
            printf("%d- %s\n", i + 1, resultados[i].titulo);}

    int escolha;
    printf("\nNumero do video: ");
    scanf("%d", &escolha);

    if (escolha < 1 || escolha > n_res) {printf("Opcao invalida.\n");
        buscar();
        return;}
        

    Video v = resultados[escolha - 1];

    /* exibe detalhes */
    printf("\n%s\n", v.titulo);
    printf("Duracao: %s\n", v.duracao);
    printf("Descricao: %s\n", v.descricao);
    printf("Canal: %s\n", v.canal);

    /* ? mostra se já curtiu */
    int curtido = ja_curtiu(v.titulo);
    if (curtido)
        printf("[<3 Voce curtiu este video]\n");

    /* submenu */
    printf("\n");
    if (curtido)
        printf("1- Descurtir\n");
    else
        printf("1- <3 Curtir\n");
    printf("2- Adicionar a playlist\n");
    printf("3- Voltar (menu principal)\n");

    int opc;
    scanf(" %d", &opc);

    if (opc == 1) {if (curtido)descurtir(v.titulo);
       			   else curtir(v.titulo); menu_principal();} 
	else if (opc == 2) {
        /* adicionar a playlist */
        char nomes[50][100];
        int total_pl = listar_playlists(nomes);
        int i;

        if (total_pl == 0) {printf("Voce ainda nao criou nenhuma playlist.\n");}
		else {printf("\nEscolha a playlist:\n");
            for (i = 0; i < total_pl; i++)
                printf("%d- %s\n", i + 1, nomes[i]); 

            printf("Numero da playlist: ");
            int num;
            scanf(" %d", &num);

            if (num >= 1 && num <= total_pl) {
                FILE *fp = fopen("playlists.txt", "a");
                if (fp) {
                    fprintf(fp, "%s;%s;%s\n", usuario_logado, nomes[num - 1], v.titulo);
                    fclose(fp);
                    printf("Video adicionado a playlist \"%s\"!\n", nomes[num - 1]);
                }
            } else {
                invalida();
            }
        }
        menu_principal();
    }
	else if (opc == 3) { menu_principal();} 
	else {invalida();buscar();}
}

/* ------------------------------------------
   VIDEOS CURTIDOS
   ------------------------------------------ */
void curtidos() {
    FILE *f = fopen("curtidos.txt", "r");
    if (!f) {
        printf("Voce ainda nao curtiu nenhum video.\n");
        menu_principal();
        return;
    }

    char u[100], t[100];
    char lista[100][100];
    int total = 0;

    while (fscanf(f, " %99[^;];%99[^\n]", u, t) == 2) {
        if (strcmp(u, usuario_logado) == 0) {
            strncpy(lista[total], t, 99);
            lista[total][99] = '\0';
            total++;
        }
    }
    fclose(f);

    if (total == 0) {
        printf("Voce ainda nao curtiu nenhum video.\n");
        menu_principal();
        return;
    }

    printf("\n=== Seus videos curtidos ===\n");
    {
        int i;
        for (i = 0; i < total; i++)
            printf("%d- %s\n", i + 1, lista[i]);
    }

    /* opção de descurtir direto da lista */
    printf("\n0- Voltar\nEscolha um numero para descurtir, ou 0 para voltar: ");
    int opc;
    scanf(" %d", &opc);

    if (opc == 0) {
        menu_principal();
    } else if (opc >= 1 && opc <= total) {
        descurtir(lista[opc - 1]);
        curtidos(); /* recarrega a lista */
    } else {
        invalida();
        curtidos();
    }
}

/* ------------------------------------------
   PLAYLISTS
   ------------------------------------------
   Arquivo playlists.txt:
   Formato: username;nome_da_playlist;titulo_do_video
   Playlist vazia = linha sem titulo: username;nome_da_playlist;
   ------------------------------------------ */

/* Retorna nomes unicos de playlists do usuario. Retorna total encontrado. */
int listar_playlists(char nomes[50][100]) {
    FILE *f = fopen("playlists.txt", "r");
    if (!f) return 0;

    char u[100], nome[100], titulo[100];
    int total = 0;
    int i;

    while (fscanf(f, " %99[^;];%99[^;];%99[^\n]", u, nome, titulo) >= 2) {
        if (strcmp(u, usuario_logado) != 0) continue;
        /* verifica se o nome ja esta na lista */
        int jatem = 0;
        for (i = 0; i < total; i++) {
            if (strcmp(nomes[i], nome) == 0) { jatem = 1; break; }
        }
        if (!jatem) {
            strncpy(nomes[total], nome, 99);
            nomes[total][99] = '\0';
            total++;
        }
    }
    fclose(f);
    return total;
}

/* Cria playlist vazia (linha sem video) */
void criar_playlist(const char *nome) {
    FILE *f = fopen("playlists.txt", "a");
    if (!f) { printf("Erro ao criar playlist.\n"); return; }
    fprintf(f, "%s;%s;\n", usuario_logado, nome);
    fclose(f);
    printf("Playlist \"%s\" criada!\n", nome);
}

/* Exclui todas as linhas de uma playlist do usuario */
void excluir_playlist(const char *nome) {
    FILE *f = fopen("playlists.txt", "r");
    if (!f) return;

    char linhas[1000][250];
    int total = 0;
    char u[100], n[100], t[100];

    while (fscanf(f, " %99[^;];%99[^;];%99[^\n]", u, n, t) >= 2) {
        if (strcmp(u, usuario_logado) == 0 && strcmp(n, nome) == 0) continue;
        snprintf(linhas[total], sizeof(linhas[total]), "%s;%s;%s", u, n, t);
        total++;
    }
    fclose(f);

    f = fopen("playlists.txt", "w");
    if (!f) { printf("Erro ao excluir playlist.\n"); return; }
    {
        int i;
        for (i = 0; i < total; i++)
            fprintf(f, "%s\n", linhas[i]);
    }
    fclose(f);
    printf("Playlist excluida.\n");
}

/* Remove um video especifico de uma playlist */
void remover_video_playlist(const char *nome_playlist, const char *titulo) {
    FILE *f = fopen("playlists.txt", "r");
    if (!f) return;

    char linhas[1000][250];
    int total = 0;
    char u[100], n[100], t[100];
    int removeu = 0;

    while (fscanf(f, " %99[^;];%99[^;];%99[^\n]", u, n, t) >= 2) {
        /* pula somente a primeira ocorrencia do video nessa playlist */
        if (!removeu && strcmp(u, usuario_logado) == 0
                     && strcmp(n, nome_playlist) == 0
                     && strcmp(t, titulo) == 0) {
            removeu = 1;
            continue;
        }
        snprintf(linhas[total], sizeof(linhas[total]), "%s;%s;%s", u, n, t);
        total++;
    }
    fclose(f);

    f = fopen("playlists.txt", "w");
    if (!f) { printf("Erro ao remover video.\n"); return; }
    {
        int i;
        for (i = 0; i < total; i++)
            fprintf(f, "%s\n", linhas[i]);
    }
    fclose(f);
    printf("Video removido da playlist.\n");
}

/* Abre e exibe uma playlist, permite excluir videos */
void abrir_playlist(const char *nome_playlist) {
    FILE *f = fopen("playlists.txt", "r");
    char videos_pl[200][100];
    int total = 0;
    char u[100], n[100], t[100];
    int i;

    if (f) {
        while (fscanf(f, " %99[^;];%99[^;];%99[^\n]", u, n, t) >= 2) {
            if (strcmp(u, usuario_logado) == 0 && strcmp(n, nome_playlist) == 0
                    && strlen(t) > 0) {
                strncpy(videos_pl[total], t, 99);
                videos_pl[total][99] = '\0';
                total++;
            }
        }
        fclose(f);
    }

    printf("\n=== Playlist: %s ===\n", nome_playlist);

    if (total == 0) {printf("Voce ainda nao adicionou nada a essa playlist.\n");}
	else {for (i = 0; i < total; i++)
            printf("%d- %s\n", i + 1, videos_pl[i]);}

    printf("\n0- Voltar (lista de playlists)\n");
    if (total > 0)
        printf("1- Digite o numero do video para excluir da playlist\n");

    int opc;
    scanf(" %d", &opc);

    if (opc == 0) {playlists();}
	    		   else if (opc == 1 && total > 0) {printf("Numero do video: ");
        int num;
        scanf(" %d", &num);
        if (num >= 1 && num <= total) {
            remover_video_playlist(nome_playlist, videos_pl[num - 1]);}
			 else {invalida();}
        abrir_playlist(nome_playlist);}
	 else {invalida();abrir_playlist(nome_playlist);}
}

void playlists() {
    char nomes[50][100];
    int total = listar_playlists(nomes);
    int i;

    printf("\n=== Playlists ===\n");

    if (total == 0) {printf("Voce ainda nao tem nenhuma playlist.\n");} 
	else {for (i = 0; i < total; i++)
            printf("%d- %s\n", i + 1, nomes[i]);}

    int opc;
    printf("\n0- Voltar (menu principal)\n");
    printf("1- Criar nova playlist\n");
    printf("2- Abrir uma playlist\n");
    printf("3- Excluir uma playlist\n");

    scanf(" %d", &opc);

    if (opc == 0) {menu_principal();} 
	else if (opc == 1) {char nome[100];
					        printf("De um nome para sua playlist: ");
					        scanf(" %99[^\n]", nome);
					        criar_playlist(nome);
					        playlists();}
					        
	else if (opc == 2) {if (total == 0) {
				            printf("Voce ainda nao tem nenhuma playlist.\n");
				            playlists();
				            return;}
				            
							int num;
							printf("Numero da playlist: ");
					        scanf(" %d", &num);
					        if (num >= 1 && num <= total) {abrir_playlist(nomes[num - 1]);}
							else {invalida();playlists();}
							} 
							
	else if (opc == 3) {if (total == 0) {
				            printf("Voce ainda nao tem nenhuma playlist.\n");
				            playlists();
				            return;}
				            
							int num;
					        printf("Numero da playlist para excluir: ");
					        scanf(" %d", &num);
					        if (num >= 1 && num <= total) {excluir_playlist(nomes[num - 1]);} 
							else {invalida();}
					        playlists();}
							else {invalida();playlists();}
 }

