/* ───────────────────────────────────────────
   SESSÃO: guarda o usuário logado globalmente
   ─────────────────────────────────────────── */
char usuario_logado[100] = "";

/* ───────────── protótipos ───────────────── */
void menu_inicial();
void criar_conta();
void fazer_login();
void menu_principal();
void buscar();
void playlists();
