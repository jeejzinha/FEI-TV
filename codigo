int username_valido(char *username) {
       FILE *f = fopen("usuarios.txt", "r");

    if (f == NULL) {
        return 1; 
    }

    char u[100], s[100];

    while (fscanf(f, "%[^;];%[^\n]\n", u, s) == 2) {
        if (strcmp(u, username) == 0) {
            fclose(f);
            return 0; // já existe
        }
    }

    fclose(f);
    return 1; // não existe ? válido
}
